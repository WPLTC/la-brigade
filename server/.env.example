# Base PostgreSQL (docker compose up -d lance une base prête à l'emploi sur ce port)
DATABASE_URL="postgresql://brigade:brigade@localhost:5434/la_brigade"

# Base dédiée aux tests d'intégration de l'API (optionnelle : ces tests sont ignorés si absente)
DATABASE_URL_TEST="postgresql://brigade:brigade@localhost:5434/la_brigade_test"

# Secret de signature des tokens JWT : mettre une longue valeur aléatoire en production
JWT_SECRET="change-me"

PORT=3001

# Origines autorisées pour CORS en production (ex : https://labrigade.fr), vide = toutes
CLIENT_ORIGIN=""
